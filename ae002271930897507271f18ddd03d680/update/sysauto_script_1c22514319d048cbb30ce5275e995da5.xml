        <script><![CDATA[(function() {
  // Find tomorrow's service requests
  var tomorrow = new GlideDate();
  tomorrow.addDaysLocalTime(1);
  
  var gr = new GlideRecord('x_2220337_vehicl_0_svc_req');
  gr.addQuery('service_date', tomorrow.getValue());
  gr.addQuery('status', 'booked');
  gr.query();
  
  var count = 0;
  while (gr.next()) {
    // Log reminder for each booking
    gs.info('Service Reminder: ' + gr.getValue('short_description') + 
            ' scheduled for ' + gr.getValue('service_date') + 
            ' (' + gr.getValue('time_slot') + ')');
    count++;
  }
  gs.info('Service Reminders: Processed ' + count + ' upcoming bookings for tomorrow');
})();
]]></script>
