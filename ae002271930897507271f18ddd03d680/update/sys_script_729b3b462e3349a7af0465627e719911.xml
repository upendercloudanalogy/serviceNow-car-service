        <script><![CDATA[(function executeRule(current, previous) {
    var vehicleId = current.getValue('vehicle');
    if (!vehicleId) return;

    var vehicleGr = new GlideRecord('x_2220337_vehicl_0_vehicle');
    if (vehicleGr.get(vehicleId)) {
        var ownerId = vehicleGr.getValue('owner');
        if (ownerId) {
            current.setValue('customer', ownerId);
        }
    }
})(current, previous);
]]></script>
