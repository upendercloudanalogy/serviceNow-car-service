        <script><![CDATA[(function executeRule(current, previous) {
    // Only auto-assign if mechanic is not already set
    if (current.getValue('mechanic')) return;
    
    var serviceType = current.getValue('service_type');
    var specialization = 'general';
    
    if (serviceType === 'repair') specialization = 'engine';
    else if (serviceType === 'inspection') specialization = 'electrical';
    
    var mechGr = new GlideRecord('x_2220337_vehicl_0_mechanic');
    mechGr.addQuery('specialization', specialization);
    mechGr.addQuery('active', true);
    mechGr.setLimit(1);
    mechGr.query();
    
    if (mechGr.next()) {
        current.setValue('mechanic', mechGr.getUniqueValue());
        gs.info('Auto-assigned mechanic: ' + mechGr.getValue('first_name') + ' ' + mechGr.getValue('last_name'));
    }
})(current, previous);
]]></script>
