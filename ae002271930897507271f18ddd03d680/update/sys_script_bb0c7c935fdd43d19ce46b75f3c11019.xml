        <condition/>
        <description>Sets task state to Closed Complete when delivered, or Closed Incomplete when cancelled.</description>
        <execute_function>false</execute_function>
        <filter_condition table="x_2220337_vehicl_0_svc_req">statusVALCHANGES^statusINdelivered,cancelled<item endquery="false" field="status" goto="false" newquery="false" operator="VALCHANGES" or="false" value=""/>
            <item endquery="false" field="status" goto="false" newquery="false" operator="IN" or="false" value="delivered,cancelled"/>
        </filter_condition>
        <is_rest>false</is_rest>
        <message/>
        <name>Set Completion Timestamp</name>
        <order>300</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous) {
    var status = current.getValue('status');

    if (status == 'delivered') {
        // Closed Complete
        current.setValue('state', 3);
        current.work_notes = 'Service request delivered and closed complete.';
    } else if (status == 'cancelled') {
        // Closed Incomplete
        current.setValue('state', 4);
        current.work_notes = 'Service request cancelled and closed incomplete.';
    }
})(current, previous);
]]></script>
